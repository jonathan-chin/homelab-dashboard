{
  "_comment": [
    "Home lab landing page - configuration.",
    "",
    "JSON has no comment syntax, so any key starting with an underscore is",
    "treated as a comment and ignored by the page. Full field reference is in",
    "README.md.",
    "",
    "This is the tracked TEMPLATE. Copy it to config.json, which is gitignored",
    "because it describes your real deployment:",
    "    cp config.example.json config.json",
    "",
    "It ships deliberately over-stuffed - delete the groups and services you do",
    "not run. Every service here is an example, not a requirement."
  ],
  "_fields": {
    "_name": "required - display name",
    "_url": "required - link target, opens in a new tab",
    "_desc": "small grey line under the name; defaults to the hostname",
    "_check": "Healthchecks slug; omit to slugify `name`; null to opt out",
    "_source": "which instance owns the check; defaults to `defaultSource`",
    "_icon": "built-in icon name, or an image path/URL",
    "_color": "tile colour, any CSS colour; ignored for image icons unless `plate` is set",
    "_plate": "true to put the colour fill back behind an image icon - for pale marks and light-ground logos",
    "_tags": "extra words the filter box should match on"
  },
  "_icons": {
    "_media": "tv, film, music, book, captions, play, request, download, chart, search",
    "_infra": "server, proxy, containers, shield, pulse, globe, network, wifi, link",
    "_data": "database, gauge, cpu, disk, clock, bell",
    "_dev": "workflow, terminal, git, bot, flask, camera",
    "_home": "home, cloud, photo, lock, document, archive",
    "_office": "wiki, tasks, calendar, mail, key, rss, utensils"
  },

  "title": "Home Lab",
  "refreshSeconds": 60,

  "_defaultSource": "which instance a service uses when it does not name one; omit to use the first below",
  "defaultSource": "local",

  "sources": {
    "_comment": "Add as many Healthchecks instances as you like - one entry per API key, each with a matching Caddy route. endpoint always points at your own origin, never at healthchecks.io, so the key stays server-side.",
    "local": { "label": "Local", "endpoint": "/api/hc/local/checks/" },
    "cloud": { "label": "Cloud", "endpoint": "/api/hc/cloud/checks/" },
    "vps": { "label": "VPS", "endpoint": "/api/hc/vps/checks/" }
  },

